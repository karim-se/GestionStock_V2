APP_NAME="GestionStock-PROD"
APP_ENV=production
APP_KEY=base64:JXwU9ClPytQo+T1K6N+u9SGzvrnWbKSDxEOnFonKAIo=
APP_DEBUG=false
APP_URL=http://localhost:9000 # On change le port pour ne pas toucher au dev

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=error

# Base de données de PRODUCTION (Différente du dev)
DB_CONNECTION=mysql
DB_HOST=db_prod
DB_PORT=3306
DB_DATABASE=GestionStock_PROD
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# Pour tes mails de test (on garde 'log' pour apprendre sans serveur SMTP)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="admin@prod.local"
MAIL_FROM_NAME="${APP_NAME}"